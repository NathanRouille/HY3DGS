#!/bin/bash
#PBS -N recon_screen
#PBS -P gs_ccds_chuanxia.zheng
#PBS -q gpu_as
#PBS -l select=1:ncpus=4:ngpus=1:mem=48gb
#PBS -l walltime=08:00:00
#PBS -j oe

set -eo pipefail
PROJECT_ROOT=/projects_vol/gp_chuanxia.zheng/nathan/HY3DGS
export EXPERIMENT="${EXPERIMENT:-global}"
export OUT="$PROJECT_ROOT/runs/recon_screen/${EXPERIMENT}_${PBS_JOBID}"
LOGDIR="$PROJECT_ROOT/runs/logs"
mkdir -p "$LOGDIR"
LOG="$LOGDIR/recon_${EXPERIMENT}_${PBS_JOBID}.log"
exec >"$LOG" 2>&1
echo "Logging to $LOG"
echo "Experiment=$EXPERIMENT host=$(hostname) CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-PBS-managed}"

module load anaconda/2025
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
conda activate /projects_vol/gp_chuanxia.zheng/nathan/env_hy3dgs
cd "$PROJECT_ROOT"
git rev-parse HEAD > "$OUT/git_commit.txt"
export HF_HOME="$PROJECT_ROOT/runs/model_cache/huggingface"
export TORCH_HOME="$PROJECT_ROOT/runs/model_cache/torch"
export XDG_CACHE_HOME="$PROJECT_ROOT/runs/model_cache/xdg"
export TMPDIR="$PROJECT_ROOT/runs/tmp/${PBS_JOBID}"
mkdir -p "$OUT" "$HF_HOME" "$TORCH_HOME" "$XDG_CACHE_HOME" "$TMPDIR"
# PBS/cgroups owns GPU selection. Do not override CUDA_VISIBLE_DEVICES.
nvidia-smi --query-gpu=name,memory.total --format=csv
python -c 'import json,os,socket,torch
if not torch.cuda.is_available():
    raise SystemExit("No CUDA GPU available in this PBS job; refusing to train on CPU.")
torch.cuda.init()
# Query CUDA itself: NVML may enumerate GPUs hidden by device cgroups.
count = torch._C._cuda_getDeviceCount()
if count != 1:
    raise SystemExit(f"Expected exactly one PBS-isolated CUDA GPU, found {count}. Check PBS GPU isolation before training.")
p = torch.cuda.get_device_properties(0)
info = {"host":socket.gethostname(),"device_count":count,"name":p.name,"memory_gib":p.total_memory/2**30,"CUDA_VISIBLE_DEVICES":os.environ.get("CUDA_VISIBLE_DEVICES")}
print(json.dumps(info))
with open(os.path.join(os.environ["OUT"],"gpu.json"),"w") as f: json.dump(info,f,indent=2)'
bash run_internscenes_recon_screen.sh
