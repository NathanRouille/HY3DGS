#!/bin/bash
#PBS -N bath10_views_d001
#PBS -P gs_ccds_chuanxia.zheng
#PBS -q gpu_as
#PBS -l select=1:ncpus=4:ngpus=1
#PBS -l walltime=24:00:00
#PBS -j oe

set -eo pipefail

PROJECT_ROOT=/projects_vol/gp_chuanxia.zheng/nathan/HY3DGS
LOGDIR="$PROJECT_ROOT/runs/logs"
mkdir -p "$LOGDIR"
LOG="${LOGDIR}/bath10_selected_views_${PBS_JOBID}.log"
exec >"$LOG" 2>&1
echo "Logging to $LOG"

module load anaconda/2025
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
conda activate /projects_vol/gp_chuanxia.zheng/nathan/env_hy3dgs

# Pull the updated repository here before submitting this job.
cd "$PROJECT_ROOT"
export PACK=/projects_vol/gp_chuanxia.zheng/nathan/datasets/internscenes_bathroom_130
export VIEW_MAP="$PROJECT_ROOT/configs/internscenes_bath10_selected_views.json"
export DELTA_WEIGHT="${DELTA_WEIGHT:-0.001}"
export NUM_STEPS="${NUM_STEPS:-20000}"
export CACHE="$PROJECT_ROOT/runs/vggt_cache/internscenes_bath10_joint_selected_v2"
export OUT="${OUT:-$PROJECT_ROOT/runs/internscenes_overfit_bath10_selected_v2_delta${DELTA_WEIGHT//./p}}"
export HF_HOME="$PROJECT_ROOT/runs/model_cache/huggingface"
export TORCH_HOME="$PROJECT_ROOT/runs/model_cache/torch"
export XDG_CACHE_HOME="$PROJECT_ROOT/runs/model_cache/xdg"
export WANDB_DIR="$OUT"
export WANDB_CACHE_DIR="$PROJECT_ROOT/runs/wandb_cache"
mkdir -p "$OUT" "$HF_HOME" "$TORCH_HOME" "$XDG_CACHE_HOME" "$WANDB_CACHE_DIR"

bash run_internscenes_overfit_bath10_selected_views.sh
