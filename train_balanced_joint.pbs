#!/bin/bash
#PBS -N bath10_patches
#PBS -P gs_ccds_chuanxia.zheng
#PBS -q gpu_as
#PBS -l select=1:ncpus=12:ngpus=1:mem=64gb
#PBS -l walltime=24:00:00
#PBS -j oe

set -eo pipefail
PROJECT_ROOT=/projects_vol/gp_chuanxia.zheng/nathan/HY3DGS
export EXPERIMENT="${EXPERIMENT:-patch_full}"
export OUT="$PROJECT_ROOT/runs/balanced_joint/${EXPERIMENT}_${PBS_JOBID}"
mkdir -p "$OUT" "$PROJECT_ROOT/runs/logs"
LOG="$PROJECT_ROOT/runs/logs/balanced_joint_${EXPERIMENT}_${PBS_JOBID}.log"
exec >"$LOG" 2>&1
echo "Logging to $LOG"
module load anaconda/2025
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
conda activate /projects_vol/gp_chuanxia.zheng/nathan/env_hy3dgs
cd "$PROJECT_ROOT"
export HF_HOME="$PROJECT_ROOT/runs/model_cache/huggingface"
export TORCH_HOME="$PROJECT_ROOT/runs/model_cache/torch"
export XDG_CACHE_HOME="$PROJECT_ROOT/runs/model_cache/xdg"
export TRITON_CACHE_DIR="$PROJECT_ROOT/runs/triton_cache/${PBS_JOBID}"
export TMPDIR="$PROJECT_ROOT/runs/tmp/${PBS_JOBID}"
mkdir -p "$HF_HOME" "$TORCH_HOME" "$XDG_CACHE_HOME" "$TRITON_CACHE_DIR" "$TMPDIR"
git rev-parse HEAD > "$OUT/git_commit.txt"
python - <<'PY'
import json, os, socket, torch
if not torch.cuda.is_available() or torch._C._cuda_getDeviceCount() != 1:
    raise SystemExit('Expected one PBS-isolated CUDA GPU')
p = torch.cuda.get_device_properties(0)
info = dict(host=socket.gethostname(), name=p.name, memory_gib=p.total_memory/2**30,
            uuid=str(getattr(p, 'uuid', 'unknown')), CUDA_VISIBLE_DEVICES=os.environ.get('CUDA_VISIBLE_DEVICES'))
print(json.dumps(info), flush=True)
with open(os.path.join(os.environ['OUT'], 'gpu.json'), 'w') as f: json.dump(info, f, indent=2)
PY
bash run_internscenes_balanced_joint.sh
